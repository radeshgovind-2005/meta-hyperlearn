{
  "name": "hyperlearn",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "deploy:widgets": "wrangler deploy -c widgets/wrangler.jsonc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "cf-typegen": "wrangler types src/server/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply hyperlearn --local",
    "db:migrate:remote": "wrangler d1 migrations apply hyperlearn --remote",
    "seed:make": "node scripts/make-seed.mjs",
    "seed:prod": "node scripts/seed.mjs --remote",
    "seed:local": "node scripts/seed.mjs --local",
    "illustrate:prod": "node scripts/illustrate.mjs --remote",
    "illustrate:local": "node scripts/illustrate.mjs"
  },
  "dependencies": {
    "@clerk/backend": "3.26.5",
    "@clerk/clerk-react": "5.61.3",
    "@clerk/hono": "0.1.96",
    "@cloudflare/puppeteer": "1.4.0",
    "@langchain/core": "1.3.2",
    "@langchain/langgraph": "1.6.0",
    "@langchain/langgraph-checkpoint": "1.2.2",
    "hono": "4.13.16",
    "katex": "0.16.22",
    "langsmith": "0.11.7",
    "mathjs": "15.2.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "unpdf": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "1.4.12",
    "@cloudflare/workers-types": "5.20261102.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/katex": "0.16.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.1"
  }
}
